# Aetheris Pro - environment template.
# Copy to .env and fill in. NEVER commit a real .env: it is gitignored on purpose.
# Exchange credentials stay server-side only and are never sent to the frontend.

# --- Application ------------------------------------------------------------
AETHERIS_ENVIRONMENT=development          # development | test | production
AETHERIS_DEBUG=true
AETHERIS_API_PREFIX=/api/v1
AETHERIS_CORS_ORIGINS=["http://localhost:3000"]

# --- Secrets (no defaults; required in production) --------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AETHERIS_SECRET_KEY=
AETHERIS_DATABASE_URL=

# --- Trading mode gating ----------------------------------------------------
# Modes never escalate on their own. Each one is switched on deliberately.
AETHERIS_DEFAULT_MODE=ANALYSIS            # ANALYSIS | PAPER | TESTNET | LIVE
AETHERIS_AUTONOMOUS_TRADING_ENABLED=false
AETHERIS_PAPER_TRADING_ENABLED=true
AETHERIS_TESTNET_TRADING_ENABLED=false

# Live trading needs BOTH switches. One flag alone is rejected at startup.
AETHERIS_LIVE_TRADING_ENABLED=false
AETHERIS_LIVE_ACTIVATION_ACKNOWLEDGED=false

# --- Risk defaults ----------------------------------------------------------
AETHERIS_RISK_PAPER_STARTING_BALANCE=100
AETHERIS_RISK_DAILY_PROFIT_TARGET=20
AETHERIS_RISK_DAILY_LOSS_LIMIT=-10        # must be negative
AETHERIS_RISK_MAX_LEVERAGE=3
AETHERIS_RISK_MAX_OPEN_POSITIONS=5
AETHERIS_RISK_MAX_POSITION_NOTIONAL=100
AETHERIS_RISK_MAX_PORTFOLIO_EXPOSURE=300
AETHERIS_RISK_ENTRY_COOLDOWN_SECONDS=300
AETHERIS_RISK_MAX_DATA_AGE_SECONDS=30

# --- Binance USDT-M Futures: PUBLIC market data (phase 2) -------------------
# Public endpoints need no credentials. None are defined for this phase.
AETHERIS_BINANCE_FUTURES_REST_BASE_URL=https://fapi.binance.com
AETHERIS_BINANCE_REQUEST_TIMEOUT_SECONDS=10.0
AETHERIS_BINANCE_CONNECT_TIMEOUT_SECONDS=5.0
AETHERIS_BINANCE_MAX_RETRIES=3
AETHERIS_BINANCE_BACKOFF_SECONDS=0.5
AETHERIS_BINANCE_MAX_BACKOFF_SECONDS=8.0

# Caches are bounded on purpose: a kline entry can hold 1500 candles and the
# target machine has ~1 GB free RAM.
AETHERIS_BINANCE_EXCHANGE_INFO_TTL_SECONDS=300.0
AETHERIS_BINANCE_TICKER_TTL_SECONDS=3.0
AETHERIS_BINANCE_KLINES_TTL_SECONDS=10.0
AETHERIS_BINANCE_TICKER_CACHE_MAX_ENTRIES=64
AETHERIS_BINANCE_KLINES_CACHE_MAX_ENTRIES=16
AETHERIS_BINANCE_DEFAULT_KLINES_LIMIT=200
AETHERIS_BINANCE_MAX_KLINES_LIMIT=1500

# --- Market-data freshness policy ------------------------------------------
# Past these ages an observation is reported STALE and carries NO value.
AETHERIS_MARKET_DATA_MAX_TICKER_AGE_SECONDS=30.0
AETHERIS_MARKET_DATA_MAX_CANDLE_AGE_MULTIPLE=2.5
AETHERIS_MARKET_DATA_SYMBOL_SEARCH_LIMIT=25

# --- Scanner bounds (phase 3) ----------------------------------------------
# These exist to stop one request becoming hundreds of upstream calls.
AETHERIS_SCANNER_DEFAULT_PAGE_SIZE=25
AETHERIS_SCANNER_MAX_PAGE_SIZE=100
AETHERIS_SCANNER_CANDIDATE_POOL_SIZE=60
AETHERIS_SCANNER_MAX_METRIC_SYMBOLS=60
AETHERIS_SCANNER_METRIC_CONCURRENCY=6
AETHERIS_SCANNER_CANDLE_LIMIT=60

# --- Exchange TRADING credentials (phase 8+; NOT used or read today) --------
# Trading permission only. Withdrawal permission must NEVER be granted.
# AETHERIS_BINANCE_TESTNET_API_KEY=
# AETHERIS_BINANCE_TESTNET_API_SECRET=
# AETHERIS_BINANCE_LIVE_API_KEY=
# AETHERIS_BINANCE_LIVE_API_SECRET=
